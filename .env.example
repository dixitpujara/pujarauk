# Copy to .env.local for development. Never commit real values.

# Public origin (no trailing slash). Used for canonicals, sitemap, OG and schema.
NEXT_PUBLIC_SITE_URL=https://www.pujaraandco.co.uk

# Cookieless analytics (Plausible-compatible). Leave empty to disable entirely.
# NEXT_PUBLIC_ANALYTICS_HOST=plausible.io
# NEXT_PUBLIC_ANALYTICS_DOMAIN=pujaraandco.co.uk

# Booking embed URL (Cal.com / Calendly public booking page). Leave empty to show
# the "book by email" fallback instead of an iframe. [CONFIRM: tool]
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/pujaraandco/consultation

# Enquiry email delivery (Resend). Without a key the API logs the enquiry and
# returns a graceful error so the visitor is shown the alternative contact route.
# RESEND_API_KEY=re_xxx
# ENQUIRY_FROM="Pujara & Co <no-reply@pujaraandco.co.uk>"
# ENQUIRY_TO=hello@pujaraandco.co.uk
# ENQUIRY_REPLY_TO=hello@pujaraandco.co.uk

# Rate limit: max submissions per IP per window (defaults 5 per 10 minutes)
# ENQUIRY_RATE_LIMIT=5
# ENQUIRY_RATE_WINDOW_SECONDS=600
